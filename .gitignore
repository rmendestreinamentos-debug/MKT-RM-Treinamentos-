# Dependências
node_modules/

# Cache do Python (gerar_imagem_genai.py)
__pycache__/
*.pyc

# Saída gerada pelo motor (PNGs)
saida/

# Acervo de fotos (~3 GB do evento) — NUNCA versionar. Fica só na máquina.
# O LEIA-ME é a exceção: ele documenta a pasta e precisa estar no repo.
marketing-instagram/fotos/*
!marketing-instagram/fotos/LEIA-ME.md

# Imagens avulsas que o dono despeja pro carrossel. Mesma regra: ficam na máquina.
marketing-instagram/imagens/*
!marketing-instagram/imagens/LEIA-ME.md

# Fonte licenciada (Chirp, do X) — arquivo de fonte proprietária não se redistribui,
# e um repositório é distribuição. Fica na máquina; o LEIA-ME diz como repor.
marketing-instagram/marca/fontes/*
!marketing-instagram/marca/fontes/LEIA-ME.md

# Segredos — NUNCA versionar
.env
*.env
gabriel gay/

# MATERIAL BRUTO — tudo que o dono enviou como fonte: prints, logos editáveis,
# ZIPs, PSD e a chave de API. Nenhum motor lê daqui; é arquivo morto de consulta.
# O que o motor usa é a versão TRATADA, que vive dentro da ferramenta que a usa
# (marketing-instagram/marca/, marketing-instagram/exemplos/).
# Fica só na máquina — junto com fotos/ e imagens/, pela mesma razão: peso.
# ⚠️ Não é backup. Se a máquina morrer, isto morre junto.
/_bruto/

# Config local do Claude Code. skills/ traz repos git aninhados (gitlink quebrado).
.claude/settings.local.json
.claude/skills/
# worktrees/ é checkout do próprio repo; commitar aqui duplicaria a árvore inteira.
.claude/worktrees/

# PDFs dos decks do Comercial 365 (~135 MB cada). O GitHub rejeita arquivo acima
# de 100 MB, então estes dois não sobem nem com força. São material de consulta:
# o motor lê o JSON em slides/conteudo/, não o PDF. Ficam só na máquina.
slides/Modelos/COMERCIAL 365 - DIA 1.pdf
slides/Modelos/COMERCIAL 365 - DIA 2.pdf

# Sistema operacional
Thumbs.db
Desktop.ini
.DS_Store
